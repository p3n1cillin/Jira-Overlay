# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
# Holds your Jira API token, plus the settings the apps discover for your site.
jira_config.json
jira_config.json.*

# ---------------------------------------------------------------------------
# Triage learner DATA — never commit
# ---------------------------------------------------------------------------
# The learner's code ships with the project, but everything it *produces* is
# derived from your real tickets — summaries, reporter names, customer
# wording — and none of that belongs in a shared repository.
triage_state.json
triage_state.json.*
triage_suggestions.json
triage_suggestions.json.*
triage_log.jsonl
triage_log.jsonl.*
triage_history.jsonl
triage_dataset.jsonl
triage_learner.log
TRIAGE_REPORT.md
TRIAGE_REVIEW_QUEUE.md
TRIAGE_REVIEW_QUEUE.md.*
triage_status.json
triage_reviews.json
triage_reviews.json.*
triage_backups/
.app-updates/
app_update_error.log
dist/

# Exported reports may name staff and ticket volumes
team-report-*.csv

# Crash logs — may quote ticket text
jira_overlay_error.log
jira_overlay_error.log.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# VS Code
.vscode/

# Screenshots / debug artefacts
*.png
